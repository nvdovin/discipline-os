# Copy this file to .env and fill in the values.
# .env is ignored by git and must never be committed.

# production | development
ENVIRONMENT=production
LOG_LEVEL=INFO

# Local browser preview only. MUST be false in production.
DEV_MODE=false

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Your numeric Telegram user ID. The bot and API accept only this user.
# Get it from @userinfobot. Leave empty only for the very first local /start.
OWNER_TELEGRAM_ID=

# Public HTTPS URL of the Mini App (for example https://discipline.example.com).
# Telegram requires HTTPS for Web Apps. Leave empty to hide the app button.
WEBAPP_URL=

# SQLite is enough for a single user.
DATABASE_URL=sqlite+aiosqlite:///./data/discipline.db

# APScheduler reminders. Keep true in production.
ENABLE_SCHEDULER=true

HOST=0.0.0.0
PORT=8000
